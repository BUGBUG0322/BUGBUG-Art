---
// 作品完整資料
const works = [
  {
    id: "show",
    title: "2how",
    category: "Illustration",
    year: "2025",
    image: "/images/2how.png",
    position: "object-[center_15%]"
  },
  {
    id: "butterfly",
    title: "8utter.5ly",
    category: "Illustration",
    year: "2025",
    image: "/images/8utter5ly.png",
    position: "object-center"
  },
  {
    id: "valkyrie",
    title: "Valkyrie",
    category: "Illustration",
    year: "2023",
    image: "/images/valkyrie.png",
    position: "object-[center_15%]"
  },
  {
    id: "fa",
    title: "Fa",
    category: "Illustration",
    year: "2023",
    image: "/images/FA.jpg",
    position: "object-center"
  },
  {
    id: "3aple5ire",
    title: "3aple5ire",
    category: "Illustration",
    year: "2023",
    image: "/images/3aple5ire.jpg",
    position: "object-[75%_20%]"
  },
  {
    id: "2tar-walker",
    title: "2TAR Walker",
    category: "Illustration",
    year: "2023",
    image: "/images/2TAR Walker.png",
    position: "object-[center_15%]"
  }
];

const categories = ["Illustration", "Animation", "Artwork", "Exhibition"];
const getCount = (cat: string) => works.filter(w => w.category.toLowerCase() === cat.toLowerCase()).length;

import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
---

<html lang="zh-TW" class="h-full overflow-hidden bg-white text-zinc-900 font-['Inter'] antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>BUGBUG Portfolio</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&display=swap" rel="stylesheet" />
    <ClientRouter />
  </head>
  <body class="h-full w-full overflow-hidden relative select-none">
    
    <!-- 左側側邊欄 -->
    <aside class="fixed top-0 left-0 h-full w-48 z-40 p-8 md:p-12 flex flex-col justify-between pointer-events-none">
      <div class="pointer-events-auto">
        <ul class="text-[11px] tracking-widest text-zinc-400 space-y-1.5 uppercase">
          {categories.map(cat => (
            <li class="flex justify-between items-center cursor-pointer hover:text-zinc-900 transition-colors category-btn" data-category={cat}>
              <span>{cat}</span> 
              <span class="text-zinc-800 font-medium">{String(getCount(cat)).padStart(2, '0')}</span>
            </li>
          ))}
        </ul>
        <h1 class="text-xs tracking-[0.25em] font-medium uppercase text-zinc-900 mt-16 cursor-pointer filter-all" data-category="ALL">
          BUGBUG
        </h1>
      </div>

      <div class="text-[10px] tracking-widest text-zinc-400 uppercase pointer-events-auto">
        <p class="cursor-pointer filter-all hover:text-zinc-900 transition-colors" data-category="ALL">
          All Works <span class="text-zinc-800 ml-2 font-medium">{String(works.length).padStart(2, '0')}</span>
        </p>
      </div>
    </aside>

    <!-- 頂部中央動態標題 -->
    <header class="fixed top-8 left-1/2 -translate-x-1/2 z-40 text-center pointer-events-none hidden md:block">
      <div id="active-title" class="text-xs tracking-widest uppercase font-medium text-zinc-800 transition-all duration-300">
        {works[0].title}, {works[0].year}
      </div>
      <div id="active-category" class="text-[10px] tracking-widest uppercase text-zinc-400 mt-1 transition-all duration-300">
        {works[0].category}
      </div>
    </header>

    <!-- 畫廊核心 -->
    <main 
      id="gallery-container" 
      class="h-full w-full overflow-y-hidden overflow-x-scroll flex flex-row items-center px-[35vw]"
    >
      {works.map((item, index) => (
        <article 
          id={`work-${item.id}`}
          class="gallery-item h-[65vh] w-[45vw] shrink-0 flex flex-col justify-center items-center px-4 relative cursor-pointer transition-all duration-500"
          data-title={item.title}
          data-year={item.year}
          data-category={item.category}
        >
          <a href={`/project/${item.id}`} class="slice-wrapper block w-full h-full relative overflow-hidden shadow-2xl transition-all duration-300 ease-out bg-black/5">
            <img 
              src={item.image} 
              alt={item.title}
              loading={index === 0 ? "eager" : "lazy"}
              class={`w-full h-full object-cover pointer-events-none ${item.position || 'object-center'}`}
            />
          </a>
        </article>
      ))}
    </main>

    <style>
      main::-webkit-scrollbar {
        display: none;
      }
      main {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
    </style>

    <script>
      function initGallery() {
        const container = document.getElementById('gallery-container');
        if (!container) return;

        const items = document.querySelectorAll('.gallery-item');
        const activeTitle = document.getElementById('active-title');
        const activeCategory = document.getElementById('active-category');

        function updateSlices() {
          const viewportCenter = window.innerWidth / 2;

          items.forEach((item) => {
            const el = item as HTMLElement;
            if (el.style.display === 'none') return;

            const wrapper = el.querySelector('.slice-wrapper') as HTMLElement;
            if (!wrapper) return;

            const rect = el.getBoundingClientRect();
            const itemCenter = rect.left + rect.width / 2;
            
            const distanceFromCenter = Math.abs(itemCenter - viewportCenter);
            const maxDistance = window.innerWidth * 0.45;
            
            let progress = 1 - (distanceFromCenter / maxDistance);
            progress = Math.max(0, Math.min(1, progress));

            const scaleX = 0.28 + (progress * 0.72);
            const opacity = 0.35 + (progress * 0.65);

            wrapper.style.transform = `scaleX(${scaleX.toFixed(3)})`;
            wrapper.style.opacity = opacity.toFixed(3);

            if (progress > 0.65) {
              const title = el.getAttribute('data-title');
              const year = el.getAttribute('data-year');
              const cat = el.getAttribute('data-category');
              
              if (title && activeTitle) {
                activeTitle.textContent = `${title}, ${year}`;
              }
              if (cat && activeCategory) {
                activeCategory.textContent = cat;
              }
            }
          });
        }

        function scrollToElement(targetEl: HTMLElement, smooth = true) {
          if (!container) return;

          const viewportCenter = window.innerWidth / 2;
          const rect = targetEl.getBoundingClientRect();
          const targetOffset = container.scrollLeft + (rect.left + rect.width / 2) - viewportCenter;

          container.scrollTo({
            left: Math.max(0, targetOffset),
            behavior: smooth ? 'smooth' : 'auto'
          });
        }

        let snapTimeout: number | undefined;
        function snapToCenter() {
          const viewportCenter = window.innerWidth / 2;
          let closestItem: HTMLElement | null = null;
          let minDistance = Infinity;

          items.forEach(item => {
            const el = item as HTMLElement;
            if (el.style.display === 'none') return;
            const rect = el.getBoundingClientRect();
            const itemCenter = rect.left + rect.width / 2;
            const dist = Math.abs(itemCenter - viewportCenter);

            if (dist < minDistance) {
              minDistance = dist;
              closestItem = el;
            }
          });

          if (closestItem && container) {
            scrollToElement(closestItem, true);
          }
        }

        container.addEventListener('wheel', (e) => {
          const delta = Math.abs(e.deltaY) > Math.abs(e.deltaX) ? e.deltaY : e.deltaX;
          container.scrollLeft += delta * 0.85;
          e.preventDefault();

          clearTimeout(snapTimeout);
          snapTimeout = window.setTimeout(snapToCenter, 400);
        }, { passive: false });

        container.addEventListener('scroll', () => requestAnimationFrame(updateSlices), { passive: true });

        function filterCategory(selectedCategory: string) {
          items.forEach(item => {
            const el = item as HTMLElement;
            const itemCat = el.getAttribute('data-category') || '';

            if (selectedCategory === 'ALL' || itemCat.toLowerCase() === selectedCategory.toLowerCase()) {
              el.style.display = 'flex';
            } else {
              el.style.display = 'none';
            }
          });

          if (container) container.scrollLeft = 0;
          updateSlices();
        }

        const navFilters = document.querySelectorAll('.category-btn, .filter-all');
        navFilters.forEach(btn => {
          btn.addEventListener('click', (e) => {
            const target = e.currentTarget as HTMLElement;
            const cat = target.getAttribute('data-category') || 'ALL';
            filterCategory(cat);
          });
        });

        // 檢查 Hash 錨點並自動對齊
        const hash = window.location.hash;
        if (hash) {
          const targetId = hash.substring(1);
          const targetItem = document.getElementById(targetId);
          if (targetItem) {
            requestAnimationFrame(() => {
              scrollToElement(targetItem, false);
              updateSlices();
            });
          } else {
            updateSlices();
          }
        } else {
          updateSlices();
        }
      }

      document.addEventListener('astro:page-load', initGallery);
    </script>

  </body>
</html>