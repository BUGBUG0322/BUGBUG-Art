export function getStaticPaths() {
  return works.map(w => ({ params: { id: w.id } }));
}

const { id } = Astro.params;

const currentIndex = works.findIndex(w => w.id === id);
const safeIndex = currentIndex !== -1 ? currentIndex : 0;
const work = works[safeIndex];

const prevWork = works[(safeIndex - 1 + works.length) % works.length];
const nextWork = works[(safeIndex + 1) % works.length];
---

<html lang="zh-TW" class="h-full bg-white text-zinc-900 font-['Inter'] antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{work.title} | BUGBUG</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&display=swap" rel="stylesheet" />
    <ClientRouter />
  </head>
  <body class="min-h-full w-full relative select-none md:overflow-hidden">
    
    <!-- 1. 導覽列：手機頂部固定（優化重疊），電腦版左側固定 -->
<aside class="fixed top-0 left-0 w-full md:w-64 md:h-full z-40 p-5 md:p-12 flex flex-row md:flex-col justify-between items-center md:items-start bg-white/90 md:bg-transparent backdrop-blur-md md:backdrop-blur-none pointer-events-none border-b border-zinc-100 md:border-b-0">
  <div class="pointer-events-auto flex items-center md:block gap-3">
    <a href="/" class="text-xs tracking-[0.25em] font-medium uppercase text-zinc-900 block hover:opacity-50 transition-opacity shrink-0">
      BUGBUG
    </a>
    <!-- 手機版用斜線分隔，避免換行與中央字體重疊 -->
    <span class="text-xs text-zinc-300 md:hidden">/</span>
    <h2 class="text-xs tracking-widest uppercase text-zinc-600 md:text-zinc-800 font-medium md:mt-8 truncate max-w-[150px] sm:max-w-none">
      {work.title}
    </h2>
    <p class="text-[10px] tracking-widest uppercase text-zinc-400 mt-0.5 hidden md:block">
      {work.category}
    </p>
  </div>

  <div class="text-[10px] tracking-widest text-zinc-400 uppercase pointer-events-auto hidden md:block">
    <p class="mb-1">{work.year}</p>
    <p class="text-zinc-800 font-medium">INDEX</p>
  </div>
</aside>

    <!-- 2. 響應式畫布：手機垂直滾動、電腦橫向滾動 -->
    <main 
      id="project-canvas"
      class="w-full pt-24 pb-28 px-6 md:py-0 md:h-full md:overflow-y-hidden md:overflow-x-scroll flex flex-col md:flex-row items-center md:pl-64 md:pr-[35vw] gap-12 md:gap-24"
    >
      
      <!-- [區塊 A] Hero 大圖 -->
      <section class="project-sec w-full md:w-auto shrink-0 md:h-[80vh] flex items-center justify-center">
        <img 
          src={work.image} 
          alt={work.title}
          transition:name={`work-img-${work.id}`}
          class="w-full max-h-[70vh] md:max-h-full md:max-w-[70vw] object-contain shadow-2xl rounded-sm block"
        />
      </section>

      <!-- [區塊 B] 影片播放區塊 -->
      {work.video && (
        <section class="project-sec w-full md:w-[60vw] md:max-w-4xl shrink-0 h-[40vh] md:h-[70vh] flex items-center justify-center bg-black/5 rounded-sm overflow-hidden shadow-2xl relative border border-zinc-100 my-4 md:my-0">
          <video 
            src={work.video} 
            autoplay 
            loop 
            muted 
            playsinline
            preload="auto"
            class="w-full h-full object-contain pointer-events-none"
          >
          </video>
        </section>
      )}

      <!-- [區塊 C] Credit 署名區塊 -->
      <section class="project-sec w-full md:w-80 shrink-0 md:h-[65vh] flex flex-col justify-between border-t md:border-t-0 md:border-l border-zinc-100 pt-8 md:pt-0 md:pl-12 py-0 md:py-6 my-auto">
        <div class="space-y-3 md:space-y-4">
          <span class="text-[10px] tracking-[0.2em] uppercase text-zinc-400 block">Description</span>
          <p class="text-xs tracking-wider text-zinc-600 leading-relaxed font-light">
            {work.desc}
          </p>
        </div>

        <div class="space-y-4 md:space-y-6 pt-8 md:pt-12 border-t border-zinc-100 mt-8 md:mt-0">
          <div>
            <p class="text-[10px] tracking-[0.2em] uppercase text-zinc-400 mb-1">{work.role || "Illustrator"}</p>
            <p class="text-xs tracking-widest uppercase font-medium text-zinc-900">{work.credit}</p>
          </div>
          <div>
            <p class="text-[10px] tracking-[0.2em] uppercase text-zinc-400 mb-1">Year</p>
            <p class="text-xs tracking-widest uppercase font-medium text-zinc-900">{work.year}</p>
          </div>
        </div>
      </section>

    </main>

    <!-- 3. 右下角切換控制列（手機底部固定居中） -->
    <footer class="fixed bottom-6 left-1/2 -translate-x-1/2 md:left-auto md:right-12 md:translate-x-0 z-40 text-[10px] tracking-widest uppercase text-zinc-400 flex gap-6 pointer-events-auto bg-white/90 backdrop-blur-md px-6 py-2.5 rounded-full border border-zinc-200/60 shadow-lg">
      <a href={`/project/${prevWork.id}`} class="hover:text-zinc-900 transition-colors">
        Prev
      </a>
      <a href="/" class="hover:text-zinc-900 transition-colors text-zinc-800 font-medium">
        Index
      </a>
      <a href={`/project/${nextWork.id}`} class="hover:text-zinc-900 transition-colors">
        Next
      </a>
    </footer>

    <style>
      main::-webkit-scrollbar {
        display: none;
      }
      main {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
    </style>

    <!-- JS 橫向滾動邏輯（僅在電腦版生效，不干擾手機直向滑動） -->
    <script>
      function setupCanvas() {
        const canvas = document.getElementById('project-canvas');
        if (!canvas) return;

        const video = canvas.querySelector('video');
        if (video) {
          video.muted = true;
          video.play().catch(() => {});
        }

        // 僅在桌面大螢幕啟用橫向磁吸與滾輪監聽
        if (window.innerWidth < 768) return;

        let snapTimeout: number | undefined;

        function snapToCenter() {
          if (!canvas || window.innerWidth < 768) return;
          const viewportCenter = window.innerWidth / 2;
          const sections = canvas.querySelectorAll('.project-sec');
          let closestSection: HTMLElement | null = null;
          let minDistance = Infinity;

          sections.forEach(sec => {
            const el = sec as HTMLElement;
            const rect = el.getBoundingClientRect();
            const sectionCenter = rect.left + rect.width / 2;
            const dist = Math.abs(sectionCenter - viewportCenter);

            if (dist < minDistance) {
              minDistance = dist;
              closestSection = el;
            }
          });

          if (closestSection) {
            const rect = (closestSection as HTMLElement).getBoundingClientRect();
            const targetOffset = canvas.scrollLeft + (rect.left + rect.width / 2) - viewportCenter;
            
            canvas.scrollTo({
              left: Math.max(0, targetOffset),
              behavior: 'smooth'
            });
          }
        }

        window.addEventListener('wheel', (e) => {
          if (!canvas || window.innerWidth < 768) return;
          
          const delta = Math.abs(e.deltaY) > Math.abs(e.deltaX) ? e.deltaY : e.deltaX;
          if (delta === 0) return;

          canvas.scrollLeft += delta * 1.5;

          clearTimeout(snapTimeout);
          snapTimeout = window.setTimeout(snapToCenter, 350);
        }, { passive: true });
      }

      document.addEventListener('astro:page-load', setupCanvas);
    </script>

  </body>
</html>