---
import '../../styles/global.css';
import { ClientRouter } from 'astro:transitions';

// 作品完整資料庫
export const works = [
  {
    id: "show",
    title: "2how",
    category: "Illustration",
    year: "2025",
    image: "/images/2how.png",
    desc: "1999 Solo Exhibition Dynamic Teaser Animation.",
    credit: "BUGBUG",
    role: "Director / Animator",
    video: "/video/2how.mp4",
    subImages: []
  },
  {
    id: "butterfly",
    title: "8utter.5ly",
    category: "Illustration",
    year: "2025",
    image: "/images/8utter5ly.png",
    desc: "Butterfly effect dynamic color study.",
    credit: "BUGBUG",
    role: "Illustrator",
    video: "/video/8utter5ly.mp4",
    subImages: []
  },
  {
    id: "valkyrie",
    title: "Valkyrie",
    category: "Illustration",
    year: "2023",
    image: "/images/valkyrie.png",
    desc: "Valkyrie Character Concept & Flame FX.",
    credit: "BUGBUG",
    role: "Illustrator",
    video: "/video/valkyrie.mp4",
    subImages: []
  },
  {
    id: "fa",
    title: "Fa",
    category: "Illustration",
    year: "2023",
    image: "/images/FA.jpg",
    desc: "Flora & Chroma composition.",
    credit: "BUGBUG",
    role: "Illustrator",
    video: "/video/FA.mp4",
    subImages: []
  },
  {
    id: "3aple5ire",
    title: "3aple5ire",
    category: "Illustration",
    year: "2023",
    image: "/images/3aple5ire.png",
    desc: "Digital Canvas Light Layering.",
    credit: "BUGBUG",
    role: "Illustrator",
    subImages: []
  },
  {
    id: "2tar-walker",
    title: "2TAR Walker",
    category: "Illustration",
    year: "2023",
    image: "/images/2TAR Walker.png",
    desc: "Urban Walker Monochrome & Cyan accent.",
    credit: "BUGBUG",
    role: "Illustrator",
    video: "/video/2TAR Walker.mp4",
    subImages: []
  }
];

export function getStaticPaths() {
  return works.map(w => ({ params: { id: w.id } }));
}

const { id } = Astro.params;

const currentIndex = works.findIndex(w => w.id === id);
const safeIndex = currentIndex !== -1 ? currentIndex : 0;
const work = works[safeIndex];

const prevWork = works[(safeIndex - 1 + works.length) % works.length];
const nextWork = works[(safeIndex + 1) % works.length];
---

<html lang="zh-TW" class="min-h-full bg-white text-zinc-900 font-['Inter'] antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{work.title} | BUGBUG</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&display=swap" rel="stylesheet" />
    <ClientRouter />
  </head>
  <body class="min-h-screen w-full relative select-none md:overflow-hidden bg-white">
    
    <!-- 1. 側邊導覽 (桌機版將 BUGBUG 移至左側垂直置中) -->
    <header class="fixed top-0 left-0 w-full md:w-64 h-auto md:h-full z-40 p-5 md:p-12 flex flex-row md:flex-col justify-between items-center md:items-start bg-white/70 md:bg-transparent backdrop-blur-md md:backdrop-blur-none pointer-events-none">
      
      <!-- 手機版置頂/桌機版靠左居中 -->
      <div class="pointer-events-auto flex items-center md:my-auto">
        <a href="/" class="text-xs tracking-[0.25em] font-medium uppercase text-zinc-900 block hover:opacity-50 transition-opacity">
          BUGBUG
        </a>
      </div>

      <!-- 底部年份標示 -->
      <div class="text-[10px] tracking-widest text-zinc-400 uppercase pointer-events-auto md:absolute md:bottom-12 md:left-12">
        <p class="hidden md:block md:mb-1">{work.year}</p>
        <p class="text-zinc-800 font-medium hidden md:block">INDEX</p>
      </div>
    </header>

    <!-- 2. 中央畫布 -->
    <main 
      id="project-canvas"
      class="w-full min-h-screen md:h-full pt-20 pb-32 md:p-0 md:overflow-y-hidden md:overflow-x-scroll flex flex-col md:flex-row items-center justify-start md:pl-72 md:pr-[30vw] gap-16 md:gap-28"
    >
      
      <!-- [區塊 A] Hero 作品主圖 -->
      <section class="project-sec w-full md:w-auto shrink-0 flex flex-col items-center justify-center px-4 md:p-0 md:h-screen">
        <div class="w-full max-h-[70vh] md:max-h-none md:h-full flex items-center justify-center overflow-hidden">
          <img 
            src={work.image} 
            alt={work.title}
            class="yoneyama-expand-img w-full h-full object-contain block"
          />
        </div>
        
        <!-- 手機版作品標題與年份 -->
        <div class="mt-8 text-center md:hidden fade-in-info">
          <h1 class="text-sm tracking-[0.2em] uppercase font-medium text-zinc-900">{work.title}</h1>
          <p class="text-[10px] tracking-widest uppercase text-zinc-400 mt-1">{work.year}, {work.category}</p>
        </div>
      </section>

      <!-- [區塊 B] 影片區塊 -->
      {work.video && (
        <section class="project-sec w-full md:w-[70vw] md:max-w-6xl shrink-0 h-[40vh] md:h-[85vh] flex items-center justify-center bg-black/5 overflow-hidden shadow-2xl border border-zinc-100 px-4 md:p-0 my-auto">
          <video 
            src={work.video} 
            autoplay 
            loop 
            muted 
            playsinline
            preload="auto"
            class="w-full h-full object-contain pointer-events-none"
          >
          </video>
        </section>
      )}

      <!-- [區塊 C] Credit 署名區塊 -->
      <section class="project-sec w-full md:w-80 shrink-0 border-t md:border-t-0 md:border-l border-zinc-100 pt-12 md:pt-0 px-8 md:p-0 md:pl-16 my-auto flex flex-col justify-center gap-10 md:h-[60vh] fade-in-info">
        <div class="space-y-3">
          <span class="text-[10px] tracking-[0.2em] uppercase text-zinc-400 block">Description</span>
          <p class="text-xs tracking-wider text-zinc-600 leading-relaxed font-light">
            {work.desc}
          </p>
        </div>

        <div class="space-y-4 pt-6 border-t border-zinc-100">
          <div>
            <p class="text-[10px] tracking-[0.2em] uppercase text-zinc-400 mb-1">{work.role || "Illustrator"}</p>
            <p class="text-xs tracking-widest uppercase font-medium text-zinc-900">{work.credit}</p>
          </div>
          <div>
            <p class="text-[10px] tracking-[0.2em] uppercase text-zinc-400 mb-1">Year</p>
            <p class="text-xs tracking-widest uppercase font-medium text-zinc-900">{work.year}</p>
          </div>
        </div>
      </section>

    </main>

    <!-- 3. 底部選單 -->
    <footer class="fixed bottom-6 left-1/2 -translate-x-1/2 md:left-auto md:right-12 md:translate-x-0 z-40 text-[10px] tracking-widest uppercase text-zinc-400 flex gap-6 pointer-events-auto bg-white/90 backdrop-blur-md px-6 py-2.5 rounded-full border border-zinc-200/60 shadow-md">
      <a href={`/project/${prevWork.id}`} class="hover:text-zinc-900 transition-colors">
        Prev
      </a>
      <a href="/" class="hover:text-zinc-900 transition-colors text-zinc-800 font-medium">
        Index
      </a>
      <a href={`/project/${nextWork.id}`} class="hover:text-zinc-900 transition-colors">
        Next
      </a>
    </footer>

    <style is:global>
      main::-webkit-scrollbar {
        display: none;
      }
      main {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }

      .yoneyama-expand-img {
        animation: yoneyamaExpand 650ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
        transform-origin: center center;
      }

      @keyframes yoneyamaExpand {
        0% {
          clip-path: inset(0 35% 0 35%);
          transform: scale(0.92);
          opacity: 0.5;
        }
        100% {
          clip-path: inset(0 0 0 0);
          transform: scale(1);
          opacity: 1;
        }
      }

      .fade-in-info {
        animation: fadeInText 800ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
      }

      @keyframes fadeInText {
        0% {
          opacity: 0;
          transform: translateY(12px);
        }
        100% {
          opacity: 1;
          transform: translateY(0);
        }
      }
    </style>

    <script>
      function handleVideoPlay() {
        const canvas = document.getElementById('project-canvas');
        if (!canvas) return;

        const videos = canvas.querySelectorAll('video');
        
        videos.forEach((video) => {
          video.muted = true;
          video.playsInline = true;
          video.load();

          const playVideo = () => {
            video.play().catch(() => {});
          };

          if (video.readyState >= 2) {
            playVideo();
          } else {
            video.addEventListener('canplay', playVideo, { once: true });
          }
        });

        if (window.innerWidth >= 768) {
          let snapTimeout: number | undefined;

          const snapToCenter = () => {
            if (!canvas || window.innerWidth < 768) return;
            const viewportCenter = window.innerWidth / 2;
            const sections = canvas.querySelectorAll('.project-sec');
            let closestSection: HTMLElement | null = null;
            let minDistance = Infinity;

            sections.forEach(sec => {
              const el = sec as HTMLElement;
              const rect = el.getBoundingClientRect();
              const sectionCenter = rect.left + rect.width / 2;
              const dist = Math.abs(sectionCenter - viewportCenter);

              if (dist < minDistance) {
                minDistance = dist;
                closestSection = el;
              }
            });

            if (closestSection) {
              const rect = (closestSection as HTMLElement).getBoundingClientRect();
              const targetOffset = canvas.scrollLeft + (rect.left + rect.width / 2) - viewportCenter;
              
              canvas.scrollTo({
                left: Math.max(0, targetOffset),
                behavior: 'smooth'
              });
            }
          };

          window.addEventListener('wheel', (e) => {
            if (!canvas || window.innerWidth < 768) return;
            const delta = Math.abs(e.deltaY) > Math.abs(e.deltaX) ? e.deltaY : e.deltaX;
            if (delta === 0) return;

            canvas.scrollLeft += delta * 1.5;
            clearTimeout(snapTimeout);
            snapTimeout = window.setTimeout(snapToCenter, 350);
          }, { passive: true });
        }
      }

      document.addEventListener('astro:page-load', handleVideoPlay);
      document.addEventListener('astro:after-swap', handleVideoPlay);
    </script>

  </body>
</html>